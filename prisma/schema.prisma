generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  role         Role      @default(READER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions Session[]
  comments Comment[]
}

enum Role {
  READER
  EDITOR
  ADMIN
  OWNER
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Manga {
  id            String      @id @default(cuid())
  title         String
  originalTitle String?
  author        String?
  description   String?
  type          String
  status        String      @default("ongoing")
  ageRestricted Boolean     @default(false)
  coverUrl      String?
  creditUrl     String?
  isLocked     Boolean  @default(false)
  passwordHash String?
  passwordHint String?
  genres        String[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  chapters Chapter[]
  views    MangaView[]
  comments Comment[]
}

model Chapter {
  id        String         @id @default(cuid())
  mangaId   String
  volume    Int?
  chapter  Float
  createdAt DateTime       @default(now())
  isLocked     Boolean  @default(false)
  passwordHash String?
  passwordHint String?

  manga    Manga          @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  images   ChapterImage[]
  comments Comment[]

  @@index([mangaId])
}

model ChapterImage {
  id        String   @id @default(cuid())
  chapterId String
  imageUrl  String
  fileName  String
  order     Int
  createdAt DateTime @default(now())

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId, order])
}

model MangaView {
  id       String   @id @default(cuid())
  mangaId  String
  viewedAt DateTime @default(now())

  manga Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@index([mangaId, viewedAt])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  mangaId   String?
  chapterId String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga   Manga?   @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mangaId])
  @@index([chapterId])
  @@index([createdAt])
}