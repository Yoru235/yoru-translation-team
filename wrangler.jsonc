{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yoru-translation-team",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
  "enabled": true
},
"images": {
  "binding": "IMAGES"
},
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "r2_buckets": [
  {
    "binding": "UPLOADS",
    "bucket_name": "yoru-uploads"
  }
]
}
